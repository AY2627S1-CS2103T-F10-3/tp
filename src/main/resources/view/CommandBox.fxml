<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>

<HBox alignment="CENTER_LEFT" spacing="10" styleClass="command-box" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1">
  <Label text=">" styleClass="command-prompt" />
  <TextField fx:id="commandTextField" onAction="#handleCommandEntered"
             promptText="Type a command and press Enter" HBox.hgrow="ALWAYS" />
</HBox>

